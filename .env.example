# DeepSeek / OpenAI API 凭证 (可选配置在 Vercel 环境变量中，配置后手机端直接免输 API Key)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# API Base URL (默认官方: https://api.deepseek.com，使用第三方中转可在此处配置)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型 (默认 deepseek-flash)
DEEPSEEK_MODEL=deepseek-flash

# 访问密码保护 (可选配置在 Vercel 环境变量中，配置后必须输入此密码才能进入网页并调用 API)
ACCESS_CODE=your-secret-password-here
